{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "//": "Migración gradual: tsc valida solo .ts/.tsx; los .jsx siguen con ESLint. Ver docs/LANZAMIENTO.md",
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/vite-env.d.ts"]
}
