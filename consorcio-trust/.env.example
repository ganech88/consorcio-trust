# Copia este archivo como .env.local y completá los valores reales.
# NUNCA commitees .env.local ni .env con credenciales reales.

# Supabase — obtenelos en: Settings > API de tu proyecto en supabase.com
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_anon_key_aqui

# MercadoPago — solo para Edge Functions de Supabase (NO en el frontend)
# Obtené tu Access Token en: https://www.mercadopago.com.ar/developers/panel/app
# Usá el token TEST-xxxx para sandbox / pruebas
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxx

# URL pública de la app (para los back_urls de MercadoPago)
APP_URL=https://consorcio-trust.vercel.app

# WhatsApp Business API — solo para Edge Functions de Supabase (NO en el frontend)
# Obtené las credenciales en: https://developers.facebook.com → tu app → WhatsApp
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=12345678901234
WHATSAPP_VERIFY_TOKEN=mi-token-secreto-para-verificacion-webhook
